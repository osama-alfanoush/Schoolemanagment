# syntax=docker/dockerfile:1

##############################################################################
# Stage 1 — builder: resolve Composer dependencies against the same PHP ABI  #
# as the runtime so compiled-extension platform requirements match exactly.  #
##############################################################################
FROM php:8.2-fpm-alpine AS builder

ARG PHPREDIS_VERSION=6.2.0
ARG PHPREDIS_SHA256=470333b27cbf9485d36b610b81300c06491a6575f22c6801a9cefc55285ed123

# Build-time system headers + PHP extensions needed to resolve/verify packages.
RUN apk add --no-cache postgresql-dev libzip-dev libxml2-dev curl-dev zip unzip $PHPIZE_DEPS && \
    curl -fsSL "https://github.com/phpredis/phpredis/archive/refs/tags/${PHPREDIS_VERSION}.tar.gz" -o /tmp/phpredis.tar.gz && \
    echo "${PHPREDIS_SHA256}  /tmp/phpredis.tar.gz" | sha256sum -c - && \
    mkdir /tmp/phpredis && \
    tar -xzf /tmp/phpredis.tar.gz -C /tmp/phpredis --strip-components=1 && \
    cd /tmp/phpredis && phpize && ./configure && make -j"$(nproc)" && make install && \
    docker-php-ext-enable redis && \
    docker-php-ext-install pdo_pgsql pcntl bcmath zip opcache simplexml curl && \
    rm -rf /tmp/phpredis /tmp/phpredis.tar.gz

# Composer (pinned major) from the official image.
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /var/www

# Install vendor deps first, keyed only on the manifests, for better layer
# caching (source changes don't invalidate the dependency layer).
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-interaction --prefer-dist \
    --no-scripts --no-autoloader

# Bring in the application source, then build the optimized autoloader and run
# package discovery (post-autoload-dump) now that the full app is present.
COPY . .
RUN composer dump-autoload --no-dev --optimize --classmap-authoritative && \
    composer run-script post-autoload-dump --no-interaction

##############################################################################
# Stage 2 — runtime: lean image with only runtime libraries, no toolchain,   #
# and no Composer binary. Runs php-fpm as the unprivileged www-data user.    #
##############################################################################
FROM php:8.2-fpm-alpine AS runtime

ARG PHPREDIS_VERSION=6.2.0
ARG PHPREDIS_SHA256=470333b27cbf9485d36b610b81300c06491a6575f22c6801a9cefc55285ed123

# Runtime shared libraries (permanent) + a throwaway build-deps layer used only
# to compile the PHP extensions, then removed so no headers/compilers ship.
RUN apk add --no-cache postgresql-libs libzip libxml2 curl && \
    apk add --no-cache --virtual .build-deps postgresql-dev libzip-dev libxml2-dev curl-dev $PHPIZE_DEPS && \
    curl -fsSL "https://github.com/phpredis/phpredis/archive/refs/tags/${PHPREDIS_VERSION}.tar.gz" -o /tmp/phpredis.tar.gz && \
    echo "${PHPREDIS_SHA256}  /tmp/phpredis.tar.gz" | sha256sum -c - && \
    mkdir /tmp/phpredis && \
    tar -xzf /tmp/phpredis.tar.gz -C /tmp/phpredis --strip-components=1 && \
    cd /tmp/phpredis && phpize && ./configure && make -j"$(nproc)" && make install && \
    docker-php-ext-enable redis && \
    docker-php-ext-install pdo_pgsql pcntl bcmath zip opcache simplexml curl && \
    rm -rf /tmp/phpredis /tmp/phpredis.tar.gz && \
    apk del .build-deps

# OPcache tuned for production — timestamps are not validated because the code
# in the image is immutable (invalidated only by a new deploy).
RUN { \
      echo "opcache.enable=1"; \
      echo "opcache.memory_consumption=256"; \
      echo "opcache.max_accelerated_files=20000"; \
      echo "opcache.validate_timestamps=0"; \
      echo "opcache.interned_strings_buffer=16"; \
    } > /usr/local/etc/php/conf.d/opcache.ini

# Never advertise the exact PHP build in HTTP responses; X-Powered-By hands an
# attacker the precise patch level to look up CVEs against. Also keep runtime
# errors out of responses regardless of what the framework does.
RUN {       echo "expose_php=Off";       echo "display_errors=Off";       echo "display_startup_errors=Off";       echo "log_errors=On";     } > /usr/local/etc/php/conf.d/zz-hardening.ini

# PHP-FPM process-manager tuning.
RUN { \
      echo "pm = dynamic"; \
      echo "pm.max_children = \${PM_MAX_CHILDREN}"; \
      echo "pm.start_servers = \${PM_START_SERVERS}"; \
      echo "pm.min_spare_servers = \${PM_MIN_SPARE}"; \
      echo "pm.max_spare_servers = \${PM_MAX_SPARE}"; \
      echo "pm.max_requests = 500"; \
      echo "request_terminate_timeout = 60s"; \
      echo "catch_workers_output = yes"; \
      echo "decorate_workers_output = no"; \
      echo "clear_env = no"; \
      echo "access.log = /dev/null"; \
      \
      # Without this there is no way to see how many workers are actually busy,
      # so "is the pool saturated?" can only be guessed at from latency. The
      # path is served only to the local nginx, never publicly.
      echo "pm.status_path = /fpm-status"; \
    } >> /usr/local/etc/php-fpm.d/www.conf

# Sized from measurement, not habit — see docs/capacity-and-performance.md.
# PM_MAX_CHILDREN is the ceiling on concurrent PHP requests for one replica and
# therefore on that replica's share of the PgBouncer client pool; the two are
# sized together.
ENV PM_MAX_CHILDREN=20 \
    PM_START_SERVERS=4 \
    PM_MIN_SPARE=2 \
    PM_MAX_SPARE=6

WORKDIR /var/www

# Copy the built application (source + optimized vendor) from the builder,
# owned by the unprivileged runtime user.
COPY --from=builder --chown=www-data:www-data /var/www /var/www

# Writable runtime paths. storage/ and bootstrap/cache are backed by volumes in
# compose; their initial ownership is seeded from these image dirs.
RUN chmod -R 775 storage bootstrap/cache

# Drop root: php-fpm master and workers all run as www-data (uid 82). The pool
# listens on unprivileged tcp/9000 (official image's zz-docker.conf), so no
# privileged capabilities are required.
USER www-data

EXPOSE 9000
CMD ["php-fpm", "--nodaemonize"]

APP_NAME="School Management Suite"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=school_dev
DB_USERNAME=school
DB_PASSWORD=

CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=database
QUEUE_AFTER_COMMIT=true

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

FILESYSTEM_DISK=local
UPLOADS_DISK=uploads
UPLOADS_DRIVER=local

CORS_ALLOWED_ORIGINS=http://localhost:5173
WEB_AUTH_COOKIE_SECURE=false
WEB_AUTH_COOKIE_SAME_SITE=lax
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

MFA_ENABLED=true
MFA_REQUIRED_ROLES=admin,finance,hr,warehouse,procurement

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@school.test"
MAIL_FROM_NAME="${APP_NAME}"

PAYMENT_PROVIDER=stripe
PAYMENT_CURRENCY=usd
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=
FCM_SERVER_KEY=

{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.railway"
  },
  "deploy": {
    "startCommand": "sh docker/railway-entrypoint.sh",
    "restartPolicyType": "ALWAYS",
    "numReplicas": 1,
    "sleepApplication": false
  }
}

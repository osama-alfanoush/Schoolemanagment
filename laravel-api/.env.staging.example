APP_NAME="School Management Suite Staging"
APP_ENV=staging
APP_KEY=GENERATE_WITH_STAGING_INIT
APP_DEBUG=false
APP_URL=http://127.0.0.1:8080
APP_TIMEZONE=UTC
LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=school_staging
DB_USERNAME=school
DB_PASSWORD=GENERATE_WITH_STAGING_INIT

CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
QUEUE_AFTER_COMMIT=true
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=GENERATE_WITH_STAGING_INIT
REDIS_PORT=6379

FILESYSTEM_DISK=s3
UPLOADS_DISK=uploads
UPLOADS_DRIVER=s3
AWS_ACCESS_KEY_ID=GENERATE_WITH_STAGING_INIT
AWS_SECRET_ACCESS_KEY=GENERATE_WITH_STAGING_INIT
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=school-private
UPLOADS_AWS_BUCKET=school-uploads

# Private uploads -- profile photos, submissions, teacher attachments -- must
# use the shared object store too. Without these three lines the private disk
# falls back to `local`, which is per-container: the replica serving a download
# is often not the replica that handled the upload, so roughly half of all
# private file requests 404, and every file is destroyed on redeploy.
#
# Staging omitted this while setting UPLOADS_DRIVER=s3 for public files, so the
# sensitive files got the least durable storage and staging could not qualify
# the private-upload path at all. .env.prod.example has always set it.
PRIVATE_UPLOADS_DISK=private_uploads
PRIVATE_UPLOADS_DRIVER=s3
PRIVATE_UPLOADS_AWS_BUCKET=school-private
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true
UPLOADS_URL=http://127.0.0.1:9000/school-uploads

CORS_ALLOWED_ORIGINS=http://127.0.0.1:8080
WEB_AUTH_COOKIE_SECURE=false
SESSION_SECURE_COOKIE=false
MFA_ENABLED=true
MFA_REQUIRED_ROLES=admin,finance,hr,warehouse,procurement

MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@staging.school.test
MAIL_FROM_NAME="School Management Suite Staging"

BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
RESTORE_RTO_SECONDS=7200

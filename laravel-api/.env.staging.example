APP_NAME="School Management Suite Staging"
APP_ENV=staging
APP_KEY=GENERATE_WITH_STAGING_INIT
APP_DEBUG=false
APP_URL=http://127.0.0.1:8080
APP_TIMEZONE=UTC
LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=school_staging
DB_USERNAME=school
DB_PASSWORD=GENERATE_WITH_STAGING_INIT

CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
QUEUE_AFTER_COMMIT=true
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=GENERATE_WITH_STAGING_INIT
REDIS_PORT=6379

FILESYSTEM_DISK=s3
UPLOADS_DISK=uploads
UPLOADS_DRIVER=s3
AWS_ACCESS_KEY_ID=GENERATE_WITH_STAGING_INIT
AWS_SECRET_ACCESS_KEY=GENERATE_WITH_STAGING_INIT
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=school-private
UPLOADS_AWS_BUCKET=school-uploads
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true
UPLOADS_URL=http://127.0.0.1:9000/school-uploads

CORS_ALLOWED_ORIGINS=http://127.0.0.1:8080
WEB_AUTH_COOKIE_SECURE=false
SESSION_SECURE_COOKIE=false
MFA_ENABLED=true
MFA_REQUIRED_ROLES=admin,finance,hr,warehouse,procurement

MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@staging.school.test
MAIL_FROM_NAME="School Management Suite Staging"

BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
RESTORE_RTO_SECONDS=7200

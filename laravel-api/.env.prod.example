APP_NAME="School Management Suite"
APP_ENV=production
APP_KEY=GENERATE_WITH_ARTISAN
APP_DEBUG=false
APP_URL=https://school.example.com
APP_TIMEZONE=UTC
# Stamped by CI with the deployed commit SHA. Appears in every log line, in the
# authenticated /api/health response and in error reports. "unknown" means the
# pipeline did not stamp the build.
APP_RELEASE=unknown

# One image, three services. Deploy this image three times on a platform that
# runs one process per service. Without a worker and a scheduler, queued mail,
# notifications, outbox delivery and every scheduled task never run.
#   web (default) | worker | scheduler
PROCESS_ROLE=web

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=school_prod
DB_USERNAME=school
DB_PASSWORD=CHANGE_THIS_DB_PASSWORD

CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
QUEUE_AFTER_COMMIT=true
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD
REDIS_PORT=6379

FILESYSTEM_DISK=local
UPLOADS_DISK=uploads
# Use s3 in production. A container filesystem is ephemeral: with `local`,
# every redeploy discards uploaded photos and documents. ops:preflight-env warns
# when this is still local.
UPLOADS_DRIVER=s3
AWS_ACCESS_KEY_ID=CHANGE_THIS_OBJECT_STORAGE_KEY
AWS_SECRET_ACCESS_KEY=CHANGE_THIS_OBJECT_STORAGE_SECRET
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=school-private
UPLOADS_AWS_BUCKET=school-uploads
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

CORS_ALLOWED_ORIGINS=https://school.example.com
WEB_AUTH_COOKIE_SECURE=true
WEB_AUTH_COOKIE_SAME_SITE=lax
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

MFA_ENABLED=true
MFA_REQUIRED_ROLES=admin,finance,hr,warehouse,procurement

MAIL_MAILER=smtp
MAIL_HOST=CHANGE_THIS_SMTP_HOST
MAIL_PORT=587
MAIL_USERNAME=CHANGE_THIS_SMTP_USERNAME
MAIL_PASSWORD=CHANGE_THIS_SMTP_PASSWORD
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@school.example.com
MAIL_FROM_NAME="School Management Suite"

PAYMENT_PROVIDER=stripe
PAYMENT_CURRENCY=usd
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=
FCM_SERVER_KEY=

BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14

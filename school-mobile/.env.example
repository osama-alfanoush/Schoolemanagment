# Base URL of the Laravel API backend. "/api" is appended automatically if missing.
# Defaults to the production Railway deployment when unset.
# NOTE: the GitHub Pages site (https://osama-alfanoush.github.io/Schoolemanagment)
# is the static web frontend — it cannot serve the API. The backend lives on Railway.
EXPO_PUBLIC_API_URL=https://schoolemanagment-production.up.railway.app
